@page "/login"
@layout AltLayout

<PageTitle>Login</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-header">
            <p>Digitalt Overlapsystem</p>
        </div>

        <section class="login-body">
            <h2>Log ind på Plejehjemmets Terminal</h2>

            <div class="input-group">
                <input type="text"
                       placeholder="Indtast plejehjemmets brugernavn"
                       @bind="Username" />
            </div>

            <div class="input-group">
                <input type="password"
                       placeholder="Indtast kodeord"
                       @bind="Password" />
            </div>

            <div class="button-group">
                <button class="login-btn" @onclick="LoginUser">Videre</button>
            </div>

            <div class="help-text">
                <p>Har du glemt kodeord?</p>
            </div>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <p class="error-text">@ErrorMessage</p>
            }
        </section>
    </div>
</div>
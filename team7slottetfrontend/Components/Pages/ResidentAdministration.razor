@page "/residentadministration"


<h2>Beboer Administration</h2>

<!-- Add Resident Section -->
<div class="add-resident-section">
  <div class="form-header">Tilføj Ny Beboer</div>
  <div class="form-row">
    <input type="text" placeholder="Fornavn" />
    <input type="text" placeholder="Efternavn" />
    <input type="text" placeholder="Dashboard Initialer" />
    <button class="btn-add-resident">Tilføj</button>
  </div>
</div>

<!-- Residents Grid -->
<div class="residents-wrapper">

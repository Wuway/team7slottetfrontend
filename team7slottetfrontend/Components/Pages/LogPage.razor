@page "/logpage"

<h2>Hændelseslog</h2>

<div class="log-toolbar">
    <button class="nav-arrow">&#8249;</button>

    <div class="log-date">Torsdag d. 26-02-2026</div>

    <button class="nav-arrow">&#8250;</button>

    <button class="today-button">I dag</button>
</div>

<div class="log-wrapper">
    <div class="log-header">
        <div>Tidspunkt</div>
        <div>Medarbejder</div>
        <div>Handling</div>
        <div>Detaljer</div>
        <div>Type</div>
        <div>ID</div>
    </div>

    @foreach (var log in logs)
    {
        <div class="log-row">
            <div>@log.Time</div>
            <div>@log.Employee</div>
            <div>@log.Action</div>
            <div>@log.Details</div>
            <div>@log.Type</div>
            <div>@log.Id</div>
        </div>
    }
</div>
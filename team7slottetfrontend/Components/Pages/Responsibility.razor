@page "/responseability"

<PageTitle>Ansvarsopgaver</PageTitle>

<div class="header-container">
    <h2>Administration af Ansvar og Opgaver</h2>
    <button class="btn-add" @onclick="ToggleAddForm">
        <span class="bi bi-plus" aria-hidden="true"></span> Tilføj Ansvar
    </button>
</div>

@if (isAddFormVisible)
{
    <div class="add-form-container">
        <input type="text" class="input-task" placeholder="Skriv en ny opgave..." @bind="newTaskName" />
        
        <div class="form-actions">
            <button class="btn-cancel" @onclick="CancelAdd">Annuller</button>
            <button class="btn-save" @onclick="SaveTask">Tilføj opgave</button>
        </div>
    </div>
}

<section class="list-section">
    <div class="table-scroll-container">
        <table class="worker-table">
            <thead>
                <tr>
                    <th class="col-id">#</th>
                    <th class="col-name">Opgave</th>
                    <th class="col-actions">Handlinger</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>1</td>
                    <td>Toilet rengøring</td>
                    <td>
                        <div class="icon-actions">
                            <button class="btn-icon">
                                <span class="bi bi-chevron-down" aria-hidden="true"></span>
                            </button>
                            <button class="btn-icon">
                                <span class="bi bi-chevron-up" aria-hidden="true"></span>
                            </button>
                            <button class="btn-icon btn-delete-icon">
                                <span class="bi bi-trash" aria-hidden="true"></span>
                            </button>
                        </div>
                    </td>
                </tr>
                </tbody>
        </table>
    </div>
</section>





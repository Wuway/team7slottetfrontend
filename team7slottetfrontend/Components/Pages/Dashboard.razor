            {
                new ScheduleMedication { DispenseAt = DateTime.Today.AddHours(8) },
                new ScheduleMedication { DispenseAt = DateTime.Today.AddHours(12) },
                new ScheduleMedication { DispenseAt = DateTime.Today.AddHours(18) }
            }
        }
    };
}

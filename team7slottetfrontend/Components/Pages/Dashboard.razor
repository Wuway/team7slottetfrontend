@using slotlib.Models
@using slotlib.Enums

@page "/dashboard"

<PageTitle>Dashboard</PageTitle>

<h3>Dashboard</h3>

<div class="dashboard-container">

    @foreach (var resident in residents)
    {
		<Card>
            <Header>
                <div class="risk-badge @GetRiskClass(resident.RiskLevel)">
                    <h3>@resident.FirstName @resident.LastName</h3>
                </div>
            </Header>

            <ChildContent>

                <div class="info-row">
                    <h5>Medicin</h5>

                    <div class="info-content">
                        @foreach (var medicin in resident.ScheduleMedications)
                        {
                            <div class="medicin-row @(medicin.IsGiven ? "done" : "pending")">
                                <span class="tid">@medicin.DispenseAt.ToShortTimeString()</span>
                                <span class="medicin-status">
                                    @(medicin.IsGiven ? "Givet" : "Ikke givet")
                                </span>
                            </div>
                        }
                    </div>
                </div>



                <div class="info-row">
                    <h5>PN-tid</h5>

                    <div class="pn-container">
                        @if (resident.PatientTimes != null && resident.PatientTimes.Any())
                        {
                            @foreach (var pn in resident.PatientTimes)
                            {
                                <div class="pn-row">
                                    <span class="tid">@pn.DispensedAt.ToShortTimeString()</span>
                                    <span class="pn-note">@pn.Note</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="pn-row empty">
                                <span>Ingen PN-tider</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="info-row">
                    <h5>Indkøbsdag</h5>

                    @if (!string.IsNullOrEmpty(resident.ShoppingDay))
                    {
                        <div class="info-box">     
                            <span>@resident.ShoppingDay</span>
                        </div>
                    }
                    else
                    {
                        <div class="info-box">Ingen indkøbsdag</div>
                    }
                </div>

                <div class="info-row">
                    <h5>Betaling</h5>
                    @if (!string.IsNullOrEmpty(resident.PaymentMethod))
                    {
                        <div class="info-box">
                            <span>@resident.PaymentMethod</span>
                          
                        </div>
                    }

                    else
                    {
                        <div class="info-box">Ingen betalingsmetode registreret</div>
                    }

                </div>

                <div class="info-row">
                    <h5>Status</h5>

                    @if (!string.IsNullOrWhiteSpace(resident.Status))
                    {
                        <div class="info-box status-box">
                            <span>@resident.Status</span>
                        </div>
                    }
                    else
                    {
                        <div class="info-box status-box">Ingen status</div>
                    }
                </div>

              
            </ChildContent>

        </Card>
    
    }
</div>

<div class="news-banner">
    <div class="ticker">
        <div class="ticker-track">

        <span class="item">HUSK RISIKOVURDERING</span>
        <span class="separator">•</span>

        <span class="item">HUSK SUNDHEDSPLANER</span>
        <span class="separator">•</span>

        <span class="item">HUSK MEDICIN</span>
        <span class="separator">•</span>

        <span class="item">HUSK DELMÅL</span>
        <span class="separator">•</span>



        <span class="item">HUSK RISIKOVURDERING</span>
